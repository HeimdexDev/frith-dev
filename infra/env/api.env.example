# Frith API — local development env (copy to .env, never commit .env).
# On ECS the same names are injected by infra/modules/api (task definition environment).
# Fill infra values with:  python3 -I infra/scripts/render_env.py api > .env
# Secrets stay empty here; set them by hand from the source named above each one.

# AWS
AWS_REGION=ap-northeast-2
PORT=8080

# S3 (raw = sharer uploads, never shown to receivers; safe = anonymized derivatives)
RAW_BUCKET=
SAFE_BUCKET=

# SQS (API -> Aircloud worker jobs; worker -> API results)
JOBS_QUEUE_URL=
RESULTS_QUEUE_URL=

# Database (RDS PostgreSQL; on ECS DB_USERNAME/DB_PASSWORD come from DB_SECRET_ARN)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SECRET_ARN=
# Local only: from `aws secretsmanager get-secret-value --secret-id $DB_SECRET_ARN`
DB_USERNAME=
DB_PASSWORD=

# Cognito (OIDC; org/dataset authorization is the API's own Postgres check)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# Aircloud GPU Worker Lifecycle (names follow livecommerce / playground)
# The API wakes the blur endpoint when it enqueues a job and stops it after idle checks.
AIRCLOUD_ENABLED=false
AIRCLOUD_BASE_URL=
# Endpoint UUID of the anonymization worker in the Aircloud console
AIRCLOUD_ENDPOINT_BLUR=
AIRCLOUD_WAKE_DEBOUNCE_SECONDS=300
# Empty = application default
AIRCLOUD_COOLDOWN_CHECKS=
# On ECS the key is read at runtime from AIRCLOUD_SECRET_ARN (JSON {"AIRCLOUD_API_KEY": "..."}).
AIRCLOUD_SECRET_ARN=
# Local only: Aircloud console API key
AIRCLOUD_API_KEY=
