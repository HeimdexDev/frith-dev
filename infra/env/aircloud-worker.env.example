# Frith anonymization worker on Aircloud (Korean region) — endpoint env.
# Set these in the Aircloud console for the blur endpoint; never bake them into the image.
# Fill infra values with:  python3 -I infra/scripts/render_env.py worker
# Message contract and credential model: infra/docs/gpu-adapter.md

# AWS
AWS_REGION=ap-northeast-2

# AWS credentials (assume-role, NOT a direct-access key)
# Unlike the livecommerce worker's static key with S3/SQS rights, this key belongs to the
# IAM user `frith-poc-external-gpu`, which can ONLY call sts:AssumeRole on WORKER_ROLE_ARN
# with WORKER_EXTERNAL_ID. Worker code assumes the role (1 h session) and uses those creds.
# Key: `aws iam create-access-key --user-name <external_gpu_user_name>` (admin, out of band)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WORKER_ROLE_ARN=
# Same value as TF_VAR_external_gpu_external_id (kept outside the repo)
WORKER_EXTERNAL_ID=
WORKER_ROLE_SESSION_SECONDS=3600

# S3 (read raw, write safe; AWS S3 directly — no MINIO_* here.
# If the heimdex worker SDK is reused: its S3 client falls back to localhost:9000 when
# MINIO_ENDPOINT is unset, so point it at S3 explicitly.)
RAW_BUCKET=
SAFE_BUCKET=
# Key prefix the role may write in SAFE_BUCKET (empty = whole bucket)
SAFE_PREFIX=

# SQS (receive jobs, send results)
JOBS_QUEUE_URL=
RESULTS_QUEUE_URL=
# Jobs queue visibility timeout is 3600 s; extend with ChangeMessageVisibility before it lapses
SQS_VISIBILITY_EXTEND_SECONDS=1800
SQS_HEARTBEAT_INTERVAL_SECONDS=600

# Worker
WORKER_ID=
USE_GPU=true
# Image pulled from ECR with the assumed role (aws ecr get-login-password)
WORKER_IMAGE=
